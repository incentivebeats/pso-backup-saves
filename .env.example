BACKUP_ROOT="$HOME/Games/pso_saves"

FLYCAST_SOURCE="$HOME/.local/share/flycast"
FLYCAST_DEST="$BACKUP_ROOT/v2/dreamcast/flycast"

PSOPEEPS_PC_SOURCE="$HOME/path/to/pso-v2-pc/Backup"
PSOPEEPS_PC_DEST="$BACKUP_ROOT/v2/pc/psopeeps"

DOLPHIN_GC_SOURCE="$HOME/.local/share/dolphin-emu/GC"
DOLPHIN_GC_DEST="$BACKUP_ROOT/v3/gamecube"

S3_ENABLED=false

S3_BUCKET="your-bucket-name"
S3_PREFIX="pso_saves/your-machine"

S3_ENDPOINT_URL="https://your-object-storage-cluster.linodeobjects.com"
S3_REGION="your-object-storage-cluster"

S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"

S3_MIN_SECONDS_BETWEEN_UPLOADS=86400
S3_STATE_FILE="$HOME/.local/state/pso-backup-saves/last_s3_upload_epoch"
